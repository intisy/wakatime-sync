{
  "$schema": "./node_modules/@intisy-ai/api/schema/plugin.schema.json",
  "id": "wakatime-sync",
  "api": 1,
  "entry": "dist/index.js",
  "displayName": "WakaTime",
  "capabilities": [
    "settings"
  ],
  "commands": [
    {
      "name": "wakatime",
      "description": "Show today's WakaTime coding activity",
      "shell": "node \"{{BUNDLE}}\" today",
      "body": "Above is today's WakaTime coding total. Report it to the user concisely."
    }
  ],
  "config": {
    "defaults": {
      "logging": true,
      "heartbeat_interval_seconds": 60,
      "cli_update_interval_hours": 4,
      "api_key": "",
      "api_url": "https://api.wakatime.com/api/v1",
      "hide_filenames": false,
      "proxy": "",
      "hostname": "",
      "hide_project_names": false
    }
  },
  "publish": {
    "generatedReadme": true
  },
  "repo": {
    "role": "WakaTime coding-activity tracking plugin",
    "category": "plugin",
    "tech": [
      "typescript"
    ]
  }
}
